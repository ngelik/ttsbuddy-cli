{
  "name": "TTSBuddy CLI demo",
  "image": "mcr.microsoft.com/devcontainers/go:1.26-bookworm@sha256:8bbd6e045ce3b7157fafb3794940342f5bf2e2a0432ed33a21c51bca8b069fe5",
  "postCreateCommand": "go mod download && go build -o /usr/local/bin/ttsbuddy . && chmod +x demo/cli-demo.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ]
    }
  },
  "remoteEnv": {
    "TTSBUDDY_API_URL": "https://www.ttsbuddy.com/v1/cli-demo",
    "TTSBUDDY_API_KEY": "ttsb_demo_cli"
  }
}
