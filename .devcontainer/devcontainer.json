{
  "name": "TTSBuddy CLI HN demo",
  "image": "mcr.microsoft.com/devcontainers/go:1.25-bookworm",
  "postCreateCommand": "go mod download && go build -o /usr/local/bin/ttsbuddy . && chmod +x demo/hn-demo.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.Go"
      ]
    }
  },
  "remoteEnv": {
    "TTSBUDDY_API_URL": "https://www.ttsbuddy.com/v1/hn-cli-demo",
    "TTSBUDDY_API_KEY": "ttsb_demo_hn"
  }
}
